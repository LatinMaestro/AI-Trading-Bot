{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-crypto-trader",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "preview",
    "TRADING_MODE": "paper",
    "LIVE_TRADING_ENABLED": "false",
    "APPROVED_PAIRS": "BTC/AUD,ETH/AUD",
    "UNIVERSE_SNAPSHOT_SHA256": "",
    "MAX_GROSS_EXPOSURE_PCT": "90",
    "DAILY_LOSS_LIMIT_PCT": "5",
    "WEEKLY_LOSS_LIMIT_PCT": "10",
    "MAX_DRAWDOWN_PCT": "15",
    "LIVE_ACTIVATION_SHA256": "",
    "EXTERNAL_INTELLIGENCE_ENABLED": "false",
    "KRAKEN_ACTIVE_MAINTENANCE_CONTRACT_JSON": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-crypto-trader-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EXTERNAL_INTELLIGENCE_QUEUE",
        "queue": "ai-crypto-trader-preview-external-intelligence"
      }
    ],
    "consumers": [
      {
        "queue": "ai-crypto-trader-preview-external-intelligence",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ai-crypto-trader-preview-external-intelligence-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *", "*/15 * * * *"]
  },
  "env": {
    "production": {
      "name": "ai-crypto-trader-production",
      "vars": {
        "APP_ENV": "production",
        "TRADING_MODE": "paper",
        "LIVE_TRADING_ENABLED": "false",
        "APPROVED_PAIRS": "BTC/AUD,ETH/AUD",
        "UNIVERSE_SNAPSHOT_SHA256": "",
        "MAX_GROSS_EXPOSURE_PCT": "90",
        "DAILY_LOSS_LIMIT_PCT": "5",
        "WEEKLY_LOSS_LIMIT_PCT": "10",
        "MAX_DRAWDOWN_PCT": "15",
        "LIVE_ACTIVATION_SHA256": "",
        "EXTERNAL_INTELLIGENCE_ENABLED": "false",
        "KRAKEN_ACTIVE_MAINTENANCE_CONTRACT_JSON": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-crypto-trader-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [],
        "consumers": []
      },
      "triggers": {
        "crons": []
      }
    }
  }
}
