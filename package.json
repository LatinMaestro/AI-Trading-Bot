{
  "name": "ai-crypto-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cf-typegen": "wrangler types --env paper",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "deploy:dry": "wrangler deploy --dry-run --env paper",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check": "npm run cf-typegen && npm run typecheck && npm test && npm run deploy:dry && npm run check:forbidden && npm run check:secrets && npm run check:universe-imports",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:universe-imports": "node scripts/check-universe-imports.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.3",
    "wrangler": "4.118.0"
  }
}
