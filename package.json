{
  "name": "ai-crypto-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "deploy:dry": "wrangler deploy --dry-run",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check": "npm run cf-typegen && npm run typecheck && npm test && npm run deploy:dry && npm run check:forbidden"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  }
}
